# MongoDB
MONGODB_URI=mongodb://weemeal:weemeal_dev@localhost:27017/weemeal?authSource=admin

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0-dev

# Image Storage (File System)
# Directory for storing recipe images (mounted as Docker volume in production)
# In Docker: /data/images (mount to host path like /mnt/user/appdata/weemeal/images)
# Local dev: ./data/images
IMAGES_DIR=./data/images

# Optional: Anthropic for AI tag generation
ANTHROPIC_API_KEY=

# Admin secret for protected endpoints (e.g., /api/admin/migrate-images)
ADMIN_SECRET=

# --- Authentication (Auth.js v5) ---
# Deployment-fixed auth mode: 'local' (username/password), 'keycloak' (OIDC),
# or 'none' (no login at all — every visitor sees and edits every recipe).
# Unset or empty means 'none', so an unconfigured instance runs open and needs
# no secrets. Set this to 'local' or 'keycloak' before exposing the instance.
# In 'none' mode AUTH_SECRET, AUTH_URL and the SEED_ADMIN_* values are unused.
AUTH_MODE=local
# Secret for signing JWT sessions (not needed in 'none' mode).
# Generate: `openssl rand -base64 32`
AUTH_SECRET=
# Public base URL of the app (behind nginx/TLS use the public https URL).
AUTH_URL=http://localhost:3000

# Local auth mode: first admin seeded on startup if no admin exists (idempotent).
# Password must satisfy the policy: 12-72 chars, upper + lower + digit + special.
SEED_ADMIN_USER=
SEED_ADMIN_PASSWORD=

# Keycloak auth mode: OIDC client WeeMeal logs in against.
# The client needs the client roles 'weemeal-user' and 'weemeal-admin' and
# must list this app's public redirect URI as a valid redirect:
#   <AUTH_URL>/api/auth/callback/keycloak
# Without 'weemeal-user' (or 'weemeal-admin') a user is refused entry.
# For local development the compose file ships a ready-made realm:
#   KEYCLOAK_ISSUER=http://localhost:8080/realms/weemeal
#   KEYCLOAK_CLIENT_ID=weemeal
#   KEYCLOAK_CLIENT_SECRET=weemeal-dev-secret
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
